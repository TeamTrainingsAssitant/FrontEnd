{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "capsule-gym-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "index": "src/index.html",
            "baseHref": "/app/",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "Saiyan-Sans.ttf",
                "input": "src/assets/fonts",
                "output": "assets/fonts"
              }
            ],
            "styles": ["src/styles.css"],
            "outputPath": "dist/capsule-gym-frontend"
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "capsule-gym-frontend:build:production" },
            "development": { "buildTarget": "capsule-gym-frontend:build" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
